__pycache__/
.venv/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
*.db
*.sqlite3
.env
.DS_Store
# Source reports remain ignored by default, except for the reviewed APEC
# benchmark document required to rebuild the versioned factual-recall fixture.
data/*
!data/dau_tu_APEC.md
dataset_store/

# Generated evaluation artifacts stay local.  Only the reproducibility
# manifest and intentionally small, reviewed fixtures are versioned.
ragas_runs/*

# JSON is ignored by default because reports can be large, but evaluation seed
# contracts and tests must be trackable on a clean clone.
*.json
!dau_tu_APEC_ragas_seed.json
!dau_tu_APEC.json
!queries_test.json
!ragas_runs/manifest.json
!ragas_runs/fixtures/
!ragas_runs/fixtures/**
!tests/
!tests/**
# Reviewed configuration and evaluation sets for report discovery.
!config/company_aliases.json
!evaluation/task_routing_contrastive.json
!evaluation/context_contrastive.json
!evaluation/web_intent_contrastive.json
# The Next.js UI: CI installs from the lockfile.
!web/package.json
!web/package-lock.json
!web/tsconfig.json

# The tests themselves are versioned; generated interpreter caches are not.
tests/**/__pycache__/
tests/**/*.py[cod]
tests/**/.DS_Store
