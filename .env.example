# Copy to FINX_HOME/.env (the repository root of a source checkout); values
# already set in the environment win. FINX_HOME itself is read only from the
# environment: an installed wheel must set it, a checkout defaults to the repo.

# Local Ollama does not require an API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_API_KEY=
OLLAMA_TEMPERATURE=0
LLM_REQUEST_TIMEOUT_SECONDS=900

OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# The web app needs a Qdrant server (QDRANT_URL, + key for Qdrant Cloud): its
# processes share the index. QDRANT_LOCATION=:memory: only suits one-off CLI runs.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCATION=

# Optional web evidence and report acquisition (`pip install -e 'backend[web]'`).
WEB_EVIDENCE_ENABLED=0
WEB_CACHE_TTL_SECONDS=21600
WEB_MISS_WAIT_SECONDS=10
# Company-news analysis for the open report; needs WEB_EVIDENCE_ENABLED=1.
# Restart BOTH API and workers after changing it.
WEB_ANALYSIS_ENABLED=0
# One budget for the news branch (fetching + analysis); analysis gets the rest.
WEB_BRANCH_BUDGET_SECONDS=75
WEB_ANALYSIS_BUDGET_SECONDS=60
WEB_ANALYSIS_MAX_MODEL_CALLS=4
WEB_ANALYSIS_MAX_ARTICLES=10
WEB_ARTICLE_FETCH_SECONDS=20
REPORT_MAX_FILE_BYTES=26214400
REPORT_MAX_PDF_PAGES=200
REPORT_DOWNLOAD_TIMEOUT_SECONDS=30
LLAMAPARSE_TIER=cost_effective
LLAMAPARSE_VERSION=2026-08-19
# Inject from a secret manager in deployed environments.
LLAMA_CLOUD_API_KEY=
# Existing LLAMAPARSE_API_KEY, LLAMA_PARSE_API_KEY or LLAMA_API_KEY are also accepted.

# Evaluation only.
# Web context rollout stays off until live resolver/QA gates are accepted.
# Restart BOTH API and workers after changing this flag.
FINX_CHAT_CONTEXT=0

# Web app (agentfinx serve / worker). Required, no default; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FINX_SECRET_KEY=
# Reports without an owner that every account may ask about (comma-separated ids).
FINX_SHARED_DATASET_IDS=
# CafeF report search in the form and the chat.
FINX_REPORT_DISCOVERY_ENABLED=0
# Origins of the Next.js UI; empty: http://127.0.0.1:3000 and http://localhost:3000.
FINX_ALLOWED_ORIGINS=
# Sign-up: invite (default, `agentfinx invites create`), open (local dev only)
# or closed. Trusted proxies: only behind a reverse proxy that overwrites
# X-Forwarded-For (see docs/security.md); empty uses the connection address.
FINX_REGISTRATION=invite
FINX_TRUSTED_PROXIES=

# Evaluation only.
RAGAS_JUDGE=ollama
RAGAS_JUDGE_MODEL=
ANTHROPIC_API_KEY=
