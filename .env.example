# Local Ollama does not require an API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_API_KEY=
OLLAMA_TEMPERATURE=0
LLM_REQUEST_TIMEOUT_SECONDS=900

OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# Configure either QDRANT_URL (+ optional key) or QDRANT_LOCATION.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCATION=:memory:

# Evaluation only.
RAGAS_JUDGE=ollama
RAGAS_JUDGE_MODEL=
ANTHROPIC_API_KEY=

